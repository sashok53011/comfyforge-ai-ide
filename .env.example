# GEMINI_API_KEY: Required only when the AI provider is set to "Google Gemini"
# in the app's Settings & AI Provider. OpenAI-compatible endpoints don't need it
# — their key is entered in the UI and passed per request.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# PORT / NODE_ENV: read by server.ts via dotenv (PORT=8014, NODE_ENV=production
# on the portal host). NODE_ENV=production makes server.ts serve the built
# dist/ bundle instead of starting the Vite dev server.
PORT=8014
NODE_ENV=production
